root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
trim_trailing_whitespace = false

[*.{toml,kts,kt,rs}]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.xml]
indent_size = 4
